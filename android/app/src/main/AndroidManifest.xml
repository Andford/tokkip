<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Pomodoro's notification and the end of each block. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tokkip's notifications are planned again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Today's agenda from the calendars synced on this device (Google Calendar included). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Events made in Tokkip go into your Google calendar on this phone. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Google Tasks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android Auto: Tokkip draws its own screen on the car's display. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <!-- The weather on the car screen: approximate location only. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Your Pixel Watch's nights, from Health Connect (read only). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Your headphones' battery for the watch (data/Headphones.kt). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Pantalla: your own app usage, read on the phone (data/ScreenUsage.kt). You turn it on in Ajustes → Acceso al uso. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Pantalla: the names and icons of the apps you open from the launcher. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tokkip">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <!-- Health Connect asks why Tokkip wants your sleep (Android 13). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- The launcher icon follows Tokkip's species (data/AppIcon.kt). -->
        <activity-alias
            android:name=".LauncherConejo"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_tokkip_conejo"
            android:roundIcon="@mipmap/ic_tokkip_conejo"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The launcher icon follows Tokkip's species (data/AppIcon.kt). -->
        <activity-alias
            android:name=".LauncherGato"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_tokkip_gato"
            android:roundIcon="@mipmap/ic_tokkip_gato"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The launcher icon follows Tokkip's species (data/AppIcon.kt). -->
        <activity-alias
            android:name=".LauncherPerro"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_tokkip_perro"
            android:roundIcon="@mipmap/ic_tokkip_perro"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The launcher icon follows Tokkip's species (data/AppIcon.kt). -->
        <activity-alias
            android:name=".LauncherRobot"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_tokkip_robot"
            android:roundIcon="@mipmap/ic_tokkip_robot"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMapache"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_tokkip_mapache"
            android:roundIcon="@mipmap/ic_tokkip_mapache"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The same, Android 14+. -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".wellness.BedReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".wellness.PomodoroReceiver"
            android:exported="false" />

        <!-- "Ya pagué" on a payment's notification (wellness/TokkipNotifier.kt). -->
        <receiver
            android:name=".wellness.DebtPaidReceiver"
            android:exported="false" />

        <!-- Buenos días, eventos, tareas, buenas noches, rachas y pagos (wellness/TokkipNotifier.kt). -->
        <receiver
            android:name=".wellness.TokkipAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Only so Tokkip can show what's playing while you focus (data/NowPlaying.kt). -->
        <service
            android:name=".data.MediaListener"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Sharing the diary's day as an image. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Home screen widgets (widget/Widgets.kt). -->
        <receiver
            android:name=".widget.TokkipWidgetReceiver"
            android:label="@string/widget_tokkip"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tokkip" />
        </receiver>

        <receiver
            android:name=".widget.BreatheWidgetReceiver"
            android:label="@string/widget_breathe"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_breathe" />
        </receiver>

        <receiver
            android:name=".widget.PomodoroWidgetReceiver"
            android:label="@string/widget_pomodoro"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pomodoro" />
        </receiver>

        <receiver
            android:name=".widget.TasksWidgetReceiver"
            android:label="@string/widget_tasks"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks" />
        </receiver>

        <receiver
            android:name=".widget.SleepWidgetReceiver"
            android:label="@string/widget_sleep"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sleep" />
        </receiver>

        <receiver
            android:name=".widget.MoodWidgetReceiver"
            android:label="@string/widget_mood"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mood" />
        </receiver>

        <receiver
            android:name=".widget.StreaksWidgetReceiver"
            android:label="@string/widget_streaks"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_streaks" />
        </receiver>

        <receiver
            android:name=".widget.CompanionWidgetReceiver"
            android:label="@string/widget_companion"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_companion" />
        </receiver>

        <receiver
            android:name=".widget.MoneyWidgetReceiver"
            android:label="@string/widget_money"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_money" />
        </receiver>

        <!-- Messages from the Tokkip app on the watch (shared/…/Sync.kt). -->
        <service
            android:name=".data.PhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/tokkip" />
            </intent-filter>
        </service>
        <!-- Tokkip in the car (Android Auto): a point-of-interest app with the
             map-with-content template, so it may draw its own screen. -->
        <service
            android:name=".car.TokkipCarService"
            android:exported="true"
            android:label="Tokkip"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
    </application>
</manifest>
